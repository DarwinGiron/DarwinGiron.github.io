# ============================================================================
# Apache / XAMPP — control de cache del codigo del sitio
# ============================================================================
# Sin un Cache-Control explicito el navegador decide solo cuanto conservar el
# JS y el CSS, y puede seguir ejecutando codigo viejo despues de publicar un
# cambio. Antes eso se compensaba a mano con ?v=16 en cada <script> y en cada
# import; era fragil, porque olvidar uno mezclaba versiones nuevas y viejas.
#
# "no-cache" NO significa "no guardes en cache": significa "guardala, pero
# revalida antes de usarla". Apache ya manda ETag y Last-Modified, asi que el
# navegador recibe un 304 vacio cuando el archivo no cambio — se reutiliza el
# archivo local y solo se vuelve a descargar cuando de verdad cambio.
#
# El equivalente para el servidor de desarrollo ('serve') esta en serve.json.
# ============================================================================

<IfModule mod_headers.c>
  # Codigo: siempre revalidar (es lo que cambia entre despliegues).
  <FilesMatch "\.(js|css|html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Imagenes y fuentes: cambian muy rara vez y pesan mucho mas, asi que se
  # dejan cachear una semana sin revalidar cada carga.
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
