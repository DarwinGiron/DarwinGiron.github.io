rules_version = '2';

// ============================================================================
// REGLAS DE SEGURIDAD DE FIRESTORE — proyecto compartido "reportes-5e94c"
// ============================================================================
// Este proyecto de Firebase ahora es COMPARTIDO por dos repos/apps distintas
// que se están unificando (transición en curso, sin migrar datos todavía):
//   1. "Reportes" (este repo) — colecciones: usuarios, reportes, zonas,
//      procesos, categorias, configuracion, puntosNorma.
//   2. "hub" (repo sig-fo-115, copiado a hub/ dentro de este mismo sitio) —
//      colecciones: usuarios (COMPARTIDA con Reportes), checklists,
//      inspecciones (SIG-FO-115), liberaciones (SIG-FO-101), sigfo101Config,
//      verificaciones_transporte.
// Un proyecto de Firebase publica un ÚNICO archivo de reglas para TODA la
// base de datos, así que ESTE archivo es el único que existe y el único que
// se publica. Antes había copias "de referencia" en hub/ y hub/sig-fo-101/;
// se eliminaron a propósito para que no haya duda de cuál es el bueno.
//
// Cada app conserva sus propias funciones auxiliares con sus propios
// nombres (no se unificó la nomenclatura para no tener que reescribir cada
// bloque de reglas ya probado):
//   - Reportes usa: estaAutenticado(), esAdmin(), esInspectorActivo(),
//     rolDe(), permisoInspector().
//   - hub usa: autenticado(), esGestor(), esUsuarioActivo(), perfil().
// La ÚNICA colección realmente compartida es "usuarios": se unificó bajo
// esGestor() (admin O coordinador, mismo nivel de privilegio, solo cambia
// el título mostrado) porque es un superconjunto de lo que ya permitía
// Reportes (rol == 'admin' siempre cumple esGestor()), así que ninguna
// cuenta admin existente pierde acceso.
//
// NOTA IMPORTANTE: TODAS las funciones auxiliares DEBEN declararse DENTRO
// de "match /databases/{database}/documents { ... }", porque usan la
// variable $(database) para construir rutas en get()/exists(). Si se
// declaran fuera de ese bloque, $(database) no está en alcance y las
// comprobaciones get()/exists() fallan silenciosamente (siempre deniegan
// el acceso).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // HELPERS — Reportes
    // ------------------------------------------------------------------
    function estaAutenticado() {
      return request.auth != null;
    }

    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
    }

    function esAdmin() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        rolDe(request.auth.uid) == 'admin';
    }

    function esInspectorActivo() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo != false;
    }

    // Permiso configurable del rol Inspector (ver configuracion/permisosInspector,
    // editable solo por el admin desde Configuraciones -> Permisos). El admin
    // NUNCA necesita pasar por aquí: sus reglas ya lo permiten todo con esAdmin().
    function permisoInspector(clave) {
      return estaAutenticado() && esInspectorActivo() &&
        exists(/databases/$(database)/documents/configuracion/permisosInspector) &&
        get(/databases/$(database)/documents/configuracion/permisosInspector).data[clave] == true;
    }

    // ------------------------------------------------------------------
    // HELPERS — hub (sig-fo-115/sig-fo-101/verificación de transporte)
    // ------------------------------------------------------------------
    function autenticado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Roles de gestión: 'admin' y 'coordinador' (Coordinador de SGIA) tienen
    // exactamente los mismos permisos; se distinguen solo por el título visible.
    function esGestor() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().rol in ['admin', 'coordinador']
        && perfil().activo != false;
    }

    // Cualquier usuario con perfil activo (inspector, admin o coordinador).
    function esUsuarioActivo() {
      return autenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().activo != false;
    }

    // ------------------------------------------------------------------
    // USUARIOS — colección COMPARTIDA por Reportes y el hub. Cada quien lee
    // su propio perfil (para resolver su rol al iniciar sesión). Solo un
    // gestor (admin o coordinador) lee la lista completa, crea perfiles o
    // cambia roles/estado activo. Nadie puede crear su propio documento
    // (lo crea un gestor al invitar). Nunca se borra: se desactiva
    // (campo "activo").
    // ------------------------------------------------------------------
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || esGestor());
      allow list: if esGestor();
      allow write: if esGestor();
    }

    // ==================================================================
    // COLECCIONES DE "Reportes" (sin cambios respecto a antes de la
    // integración con el hub)
    // ==================================================================

    // ------------------------------------------------------------------
    // REPORTES
    // ------------------------------------------------------------------
    match /reportes/{reporteId} {
      allow read: if esAdmin() ||
        (estaAutenticado() && resource.data.inspectorUid == request.auth.uid) ||
        permisoInspector('dashboard') || permisoInspector('validacion') || permisoInspector('informes');

      allow create: if estaAutenticado() && (esAdmin() || esInspectorActivo()) &&
        request.resource.data.inspectorUid == request.auth.uid &&
        request.resource.data.estado == 'pendiente' &&
        request.resource.data.gravedad == null;

      // Editar cualquier reporte (validación, correcciones, reasignaciones
      // por fusión de catálogos) requiere ser admin O tener el permiso
      // "validacion". Excepciones puntuales para el propio inspector, sin
      // permiso de validación, sobre SU PROPIO reporte:
      //  - marcar como "visto" el aviso de cambios del admin
      //    (cambioSinVer: true -> false), sin tocar ningún otro campo;
      //  - actualizar "estadoHallazgo" (seguimiento propio de si el hallazgo
      //    físico ya se corrigió en planta), un campo aparte de la
      //    validación de datos que hace el admin.
      allow update: if esAdmin() || permisoInspector('validacion') ||
        (estaAutenticado() && resource.data.inspectorUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cambioSinVer']) &&
         request.resource.data.cambioSinVer == false) ||
        (estaAutenticado() && resource.data.inspectorUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoHallazgo']));

      // Borrar reportes es SIEMPRE exclusivo del admin (ej. registros de
      // prueba o duplicados), incluso si el inspector tiene permiso de
      // validación: corregir no es lo mismo que borrar permanentemente.
      allow delete: if esAdmin();
    }

    // ------------------------------------------------------------------
    // ZONAS
    // ------------------------------------------------------------------
    match /zonas/{zonaId} {
      allow read: if estaAutenticado();

      // Un inspector puede CREAR una zona nueva (alta en línea), marcando
      // explícitamente su propia autoría y origenInspector = true.
      allow create: if estaAutenticado() && esInspectorActivo() &&
        request.resource.data.creadaPor == request.auth.uid &&
        request.resource.data.origenInspector == true;

      // El admin también puede crear (origenInspector = false).
      allow create: if esAdmin();

      // Editar (renombrar/fusionar/desactivar) requiere ser admin o tener
      // el permiso de esta sección de Configuraciones.
      allow update: if esAdmin() || permisoInspector('configSeccionZonas');
      allow delete: if false; // se desactiva, nunca se borra (evita romper reportes históricos)
    }

    // ------------------------------------------------------------------
    // PROCESOS (mismas reglas que zonas)
    // ------------------------------------------------------------------
    match /procesos/{procesoId} {
      allow read: if estaAutenticado();

      allow create: if estaAutenticado() && esInspectorActivo() &&
        request.resource.data.creadaPor == request.auth.uid &&
        request.resource.data.origenInspector == true;

      allow create: if esAdmin();
      allow update: if esAdmin() || permisoInspector('configSeccionProcesos');
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // PUNTOS DE NORMA - solo lectura para inspectores, control total admin
    // (reemplazada por CATEGORIAS en el formulario de reportes; se deja la
    // colección/regla intacta para no perder el historial de reportes viejos)
    // ------------------------------------------------------------------
    match /puntosNorma/{puntoId} {
      allow read: if estaAutenticado();
      allow create, update: if esAdmin();
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // CATEGORIAS - lista cerrada gestionada por el admin (ej. "Control de
    // plagas", "Higiene personal"), o por el inspector si tiene el permiso
    // "configSeccionCategorias". Los inspectores sin ese permiso solo leen.
    // ------------------------------------------------------------------
    match /categorias/{categoriaId} {
      allow read: if estaAutenticado();
      allow create, update: if esAdmin() || permisoInspector('configSeccionCategorias');
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // CONFIGURACION - ajustes generales. Cualquier usuario autenticado puede
    // leer cualquier documento. Escribir está restringido por documento:
    //  - "permisosInspector" (los permisos en sí): SIEMPRE exclusivo del admin.
    //  - "planta"/"planoImagen"/"calibracionGPS"/"planoArchivo" (ubicación y
    //    plano de planta): admin o permiso "configSeccionUbicacionPlanta".
    //  - "planoReporte" (tamaño del plano en el formulario): admin o permiso
    //    "configSeccionPlanoReporte".
    //  - cualquier otro documento nuevo que se agregue aquí: exclusivo admin
    //    por defecto, hasta que se le agregue una excepción explícita arriba.
    // ------------------------------------------------------------------
    match /configuracion/{configId} {
      allow read: if estaAutenticado();
      allow create, update: if esAdmin() ||
        ((configId == 'planta' || configId == 'planoImagen' || configId == 'calibracionGPS' || configId == 'planoArchivo') &&
         permisoInspector('configSeccionUbicacionPlanta')) ||
        (configId == 'planoReporte' && permisoInspector('configSeccionPlanoReporte'));
      allow delete: if false;
    }

    // ==================================================================
    // COLECCIONES del "hub" (repo sig-fo-115: checklists SIG-FO-115,
    // liberaciones SIG-FO-101, verificaciones de transporte). Sin cambios
    // respecto a como estaban en el proyecto "reportes-inocuidad" original.
    // ==================================================================

    // ---- checklists (borrador de trabajo) -------------------
    // Cualquier usuario activo puede leer la estructura vigente.
    // Solo los roles de gestión pueden crear, editar o publicar cambios.
    match /checklists/{checklistId} {
      allow read: if esUsuarioActivo();
      allow write: if esGestor();

      // ---- versiones publicadas (inmutables) ----------------
      match /versiones/{numero} {
        allow read: if esUsuarioActivo();
        // Una versión publicada nunca se edita ni se borra, solo se crea.
        allow create: if esGestor();
        allow update, delete: if false;
      }
    }

    // ---- inspecciones (recorridos SIG-FO-115) ----------------------------
    // Un recorrido cubre TODAS las áreas de un turno en un solo documento
    // (id determinístico fecha_turno_uid, ver idRecorrido() en firestore.js).
    match /inspecciones/{recorridoId} {
      // El inspector solo ve los suyos; admin y coordinador ven todos.
      allow get: if autenticado()
        && (esGestor() || resource.data.inspectorUid == request.auth.uid);

      // Firestore evalúa "list" contra el resultado potencial de la consulta:
      // si el inspector no incluye where("inspectorUid","==", su uid) en la
      // consulta, la petición completa se rechaza (no se filtra parcialmente).
      allow list: if esGestor()
        || (esUsuarioActivo() && resource.data.inspectorUid == request.auth.uid);

      // Todo usuario activo (incluidos admin y coordinador, que también
      // inspeccionan) solo puede crear recorridos a su propio nombre, ya
      // sea un borrador en curso o uno ya finalizado (si nunca usó "Guardar").
      allow create: if esUsuarioActivo()
        && request.resource.data.inspectorUid == request.auth.uid
        && request.resource.data.estado in ['borrador', 'enviada'];

      // Un borrador solo lo sigue editando su propio autor, y solo mientras
      // SIGA siendo borrador: puede pasar a "enviada" (finalizarlo), nunca
      // al revés. En cuanto queda "enviada" se vuelve inmutable para
      // actualizar, preservando la integridad del registro histórico.
      allow update: if esUsuarioActivo()
        && resource.data.inspectorUid == request.auth.uid
        && resource.data.estado == 'borrador'
        && request.resource.data.inspectorUid == request.auth.uid
        && request.resource.data.estado in ['borrador', 'enviada'];

      // Un inspector solo descarta su propio borrador (nunca uno ya enviado).
      // Un gestor puede eliminar cualquier recorrido, para depurar registros.
      allow delete: if esUsuarioActivo()
        && (
          esGestor()
          || (resource.data.inspectorUid == request.auth.uid && resource.data.estado == 'borrador')
        );
    }

    // ---- auditoriasBpm (SIG-FO-116) -----------------------------
    // Un documento por mes (id "aaaa-mm"), no por usuario: a diferencia de
    // "inspecciones", esta es una auditoría compartida que cualquier usuario
    // activo puede seguir llenando (autoguardado continuo, sin dueño único).
    // Solo un gestor la elimina, igual que las demás colecciones de registro.
    match /auditoriasBpm/{claveMes} {
      allow read: if esUsuarioActivo();
      allow create, update: if esUsuarioActivo();
      allow delete: if esGestor();
    }

    // ---- liberaciones (SIG-FO-101) -----------------------------
    match /liberaciones/{liberacionId} {
      allow read: if esUsuarioActivo();

      allow create: if esUsuarioActivo()
        && request.resource.data.inspectorUid == request.auth.uid;

      // El autor corrige su propio registro; un gestor corrige cualquiera.
      // Ninguno de los dos puede cambiar de dueño el registro ni alterar
      // su timestamp original de creación.
      allow update: if esUsuarioActivo()
        && (resource.data.inspectorUid == request.auth.uid || esGestor())
        && request.resource.data.inspectorUid == resource.data.inspectorUid
        && request.resource.data.timestamp == resource.data.timestamp;

      allow delete: if esGestor();
    }

    // ---- sigfo101Config (catálogo de máquinas + preguntas SI/NO) ------
    match /sigfo101Config/{docId} {
      allow read: if esUsuarioActivo();
      allow write: if esGestor();
    }

    // ---- verificaciones_transporte (Verificación de Transporte) ------
    match /verificaciones_transporte/{verificacionId} {
      allow read: if esUsuarioActivo();

      allow create: if esUsuarioActivo()
        && request.resource.data.inspectorUid == request.auth.uid;

      allow update: if esUsuarioActivo()
        && (resource.data.inspectorUid == request.auth.uid || esGestor())
        && request.resource.data.inspectorUid == resource.data.inspectorUid
        && request.resource.data.fechaCreacion == resource.data.fechaCreacion;

      allow delete: if esGestor();
    }
  }
}
